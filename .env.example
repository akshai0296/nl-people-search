# Copy to .env.local (or export in your shell) before `make dev`.
# Supabase connection details are not needed here: they are read from the running local
# stack by scripts/with-supabase-env.sh.

# Claude Haiku 5.5 turns briefs into filters.
ANTHROPIC_API_KEY=

# Secret used to verify Stripe webhook signatures (the sample events use this one).
STRIPE_WEBHOOK_SECRET=whsec_people_search_demo

# Optional: reject webhook signatures older than this many seconds. Unset = no age check.
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
